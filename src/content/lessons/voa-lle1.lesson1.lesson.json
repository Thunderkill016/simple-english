                        { "text": "Set a Goal", "prov": { "kind": "source", "ref": "lesson-plan", "note": "Learning Strategy" } },
                        { "text": "It is best to set a short-term and small goal. Remind them to focus on this goal as they study.", "prov": { "kind": "source", "ref": "lesson-plan", "note": "verbatim plan sentence (teacher voice retained)" } }
