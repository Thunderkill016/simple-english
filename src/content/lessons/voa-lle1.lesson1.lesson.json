                        { "text": "Introduce yourself", "prov": { "kind": "source", "ref": "lesson-plan", "note": "Topics" } }
                      ]
                    },
                    {
                      "type": "read",
                      "id": "orient-goals-list",
                      "blocks": [
                        { "text": "Grammar: Verb BE (I am) in introductions; BE + location", "prov": { "kind": "source", "ref": "lesson-plan", "note": "Goals" } },
                        { "text": "Speaking: Meeting people; Ask question and answer “Are you (name)?”", "prov": { "kind": "source", "ref": "lesson-plan", "note": "Goals" } },
                        { "text": "Review alphabet and numbers 1-20", "prov": { "kind": "source", "ref": "lesson-plan", "note": "Goals" } },
