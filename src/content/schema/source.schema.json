{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://simple-english.dev/schema/source.schema.json",
  "title": "SE Source Record",
  "description": "LRMI-aligned provenance record for an educational source SE may reuse or adapt. Provenance fields are load-bearing — validation runs in CI.",
  "type": "object",
  "required": [
    "id",
    "title",
    "authors",
    "publisher",
    "url",
    "license",
    "licenseUrl",
    "reuseStatus",
    "verifiedAt"
  ],
  "additionalProperties": false,
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" },
    "type": { "type": "string" },
    "title": { "type": "string", "minLength": 1 },
    "authors": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
    "publisher": { "type": "string", "minLength": 1 },
    "url": { "type": "string", "minLength": 1 },
    "license": { "type": "string", "minLength": 1 },
    "licenseUrl": { "type": "string", "minLength": 1 },
    "contentType": { "type": "array", "items": { "type": "string" } },
    "levels": { "type": "array", "items": { "type": "string" } },
    "subjects": { "type": "array", "items": { "type": "string" } },
    "reuseStatus": { "type": "string", "enum": ["approved", "review-required", "prohibited"] },
    "provenanceNotes": { "type": "string" },
    "verifiedAt": { "type": "string", "minLength": 1 },
    "verifiedBy": { "type": "string" },
    "adaptationLog": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["item"],
        "additionalProperties": false,
        "properties": {
          "item": { "type": "string", "minLength": 1 },
          "itemUrl": { "type": "string" },
          "itemLicense": { "type": "string" },
          "itemAuthors": { "type": "array", "items": { "type": "string" } },
          "usedIn": { "type": "string" },
          "evidence": { "type": "string" },
          "notes": { "type": "string" }
        }
      }
    }
  }
}
