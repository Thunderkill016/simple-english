{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://simple-english.dev/schema/lesson.schema.json",
  "title": "SE Lesson",
  "description": "Normalized lesson unit for Simple English. Deliberately minimal — extend only when a real content need exists.",
  "type": "object",
  "required": ["schemaVersion", "id", "title", "level", "source", "blocks"],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": { "type": "integer", "const": 1 },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
      "description": "URL-safe stable identifier"
    },
    "title": { "type": "string", "minLength": 1 },
    "level": { "type": "string", "enum": ["beginner", "elementary", "intermediate"] },
    "source": {
      "type": "object",
      "required": ["id", "title", "license", "url", "adapted"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "title": { "type": "string", "minLength": 1 },
        "license": { "type": "string", "minLength": 1 },
        "url": { "type": "string", "minLength": 1 },
        "licenseUrl": {
          "type": "string",
          "description": "canonical URL of the source license deed"
        },
        "adapted": {
          "type": "boolean",
          "description": "true when SE adapted this from an external source"
        },
        "synthetic": {
          "type": "boolean",
          "description": "true when content is SE-authored fixture/test data, not real curriculum"
        },
        "attribution": {
          "type": "string",
          "description": "attribution line satisfying the source license obligations (author, work, license, changes)"
        }
      }
    },
    "blocks": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/block" }
    }
  },
  "$defs": {
    "block": {
      "oneOf": [
        {
          "type": "object",
          "required": ["type", "text"],
          "additionalProperties": false,
          "properties": {
            "type": { "const": "heading" },
            "text": { "type": "string", "minLength": 1 }
          }
        },
        {
          "type": "object",
          "required": ["type", "text"],
          "additionalProperties": false,
          "properties": {
            "type": { "const": "text" },
            "text": { "type": "string", "minLength": 1 }
          }
        },
        {
          "type": "object",
          "required": ["type", "text"],
          "additionalProperties": false,
          "properties": {
            "type": { "const": "example" },
            "text": { "type": "string", "minLength": 1 },
            "translation": { "type": "string" }
          }
        },
        {
          "type": "object",
          "required": ["type", "id", "prompt", "options", "answer"],
          "additionalProperties": false,
          "properties": {
            "type": { "const": "multiple-choice" },
            "id": { "type": "string", "minLength": 1 },
            "prompt": { "type": "string", "minLength": 1 },
            "options": {
              "type": "array",
              "minItems": 2,
              "items": {
                "type": "object",
                "required": ["id", "text"],
                "additionalProperties": false,
                "properties": {
                  "id": { "type": "string", "minLength": 1 },
                  "text": { "type": "string", "minLength": 1 }
                }
              }
            },
            "answer": {
              "type": "string",
              "description": "id of the correct option"
            }
          }
        }
      ]
    }
  }
}
