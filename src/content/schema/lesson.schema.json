{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://simple-english.dev/schema/lesson.schema.json",
  "title": "SE Lesson",
  "description": "Normalized lesson unit for Simple English. Deliberately minimal — extend only when a real content need exists. v2: lessons are SE-authored multi-source syntheses — single-source `source` replaced by authoredBy + sourceRefs + block-level provenance.",
  "type": "object",
  "required": [
    "schemaVersion",
    "id",
    "title",
    "level",
    "summary",
    "capability",
    "authoredBy",
    "sourceRefs",
    "blocks"
  ],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": { "type": "integer", "const": 2 },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
      "description": "URL-safe stable identifier, SE-owned — never encodes a source name"
    },
    "title": { "type": "string", "minLength": 1 },
    "level": { "type": "string", "enum": ["beginner", "elementary", "intermediate"] },
    "summary": {
      "type": "string",
      "minLength": 1,
      "description": "one-sentence learner-facing description shown on Today/Learn"
    },
    "capability": {
      "type": "string",
      "minLength": 1,
      "description": "what the learner can do after completing the lesson"
    },
    "authoredBy": {
      "type": "string",
      "minLength": 1,
      "description": "author of the synthesized lesson — 'Simple English' for canonical lessons, 'SE fixture' for synthetic test content"
    },
    "sourceRefs": {
      "type": "array",
      "description": "external sources the lesson draws on; synthetic fixtures use []",
      "items": {
        "type": "object",
        "required": ["id", "sourceId", "itemUrl", "role", "use"],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "description": "local key blocks' provenance.sourceRef points to; unique within the lesson (semantic check)"
          },
          "sourceId": {
            "type": "string",
            "minLength": 1,
            "description": "registry key — must match a record in src/content/sources/ (semantic check)"
          },
          "itemTitle": { "type": "string", "minLength": 1 },
          "itemUrl": {
            "type": "string",
            "pattern": "^https://",
            "description": "canonical URL of the specific source item used"
          },
          "role": {
            "type": "string",
            "minLength": 1,
            "description": "what this source contributes, e.g. 'primary-language-model', 'structure', 'naturalness-benchmark'"
          },
          "use": {
            "type": "string",
            "enum": ["reused", "adapted", "reference"],
            "description": "how SE uses the item — 'reference' sources contribute no copied content (semantic check enforces)"
          }
        }
      }
    },
    "completion": {
      "type": "object",
      "required": ["statement", "skills"],
      "additionalProperties": false,
      "properties": {
        "statement": {
          "type": "string",
          "minLength": 1,
          "description": "capability-completion sentence, e.g. 'You can meet someone in English.'"
        },
        "skills": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 },
          "description": "what the learner practiced, shown on completion"
        },
        "note": {
          "type": "string",
          "minLength": 1,
          "description": "honest bound on the claim — e.g. one practice session is not mastery"
        }
      }
    },
    "blocks": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/block" }
    }
  },
  "$defs": {
    "provenance": {
      "type": "object",
      "required": ["kind"],
      "additionalProperties": false,
      "properties": {
        "kind": {
          "type": "string",
          "enum": ["reused", "adapted", "se-authored", "reference"],
          "description": "origin of this block's English content; Vietnamese translations on any block are always SE-authored"
        },
        "sourceRef": {
          "type": "string",
          "minLength": 1,
          "description": "sourceRefs[].id this block derives from — required for reused/adapted/reference, forbidden for se-authored (semantic check)"
        }
      }
    },
    "block": {
      "oneOf": [
        {
          "type": "object",
          "required": ["type", "text"],
          "additionalProperties": false,
          "properties": {
            "type": { "const": "heading" },
            "text": { "type": "string", "minLength": 1 },
            "provenance": { "$ref": "#/$defs/provenance" }
          }
        },
        {
          "type": "object",
          "required": ["type", "text"],
          "additionalProperties": false,
          "properties": {
            "type": { "const": "text" },
            "text": { "type": "string", "minLength": 1 },
            "provenance": { "$ref": "#/$defs/provenance" }
          }
        },
        {
          "type": "object",
          "required": ["type", "text"],
          "additionalProperties": false,
          "properties": {
            "type": { "const": "example" },
            "text": { "type": "string", "minLength": 1 },
            "translation": {
              "type": "string",
              "description": "secondary-language support — always SE-authored"
            },
            "provenance": { "$ref": "#/$defs/provenance" }
          }
        },
        {
          "type": "object",
          "required": ["type", "id", "prompt", "options", "answer"],
          "additionalProperties": false,
          "properties": {
            "type": { "const": "multiple-choice" },
            "id": { "type": "string", "minLength": 1 },
            "prompt": { "type": "string", "minLength": 1 },
            "options": {
              "type": "array",
              "minItems": 2,
              "items": {
                "type": "object",
                "required": ["id", "text"],
                "additionalProperties": false,
                "properties": {
                  "id": { "type": "string", "minLength": 1 },
                  "text": { "type": "string", "minLength": 1 }
                }
              }
            },
            "answer": {
              "type": "string",
              "description": "id of the correct option"
            },
            "provenance": { "$ref": "#/$defs/provenance" }
          }
        },
        {
          "type": "object",
          "required": ["type", "title", "src", "transcript", "evidence"],
          "additionalProperties": false,
          "properties": {
            "type": { "const": "audio" },
            "title": { "type": "string", "minLength": 1 },
            "src": {
              "type": "string",
              "pattern": "^/media/",
              "description": "local static asset — SE hosts only rights-verified media; external audio goes through external-embed or links, never rehosted files"
            },
            "transcript": {
              "type": "string",
              "minLength": 1,
              "description": "full transcript — keeps the lesson usable when audio fails or the learner prefers reading"
            },
            "evidence": {
              "type": "string",
              "minLength": 1,
              "description": "repo-relative path to the retained rights/hash evidence JSON (verified at build time)"
            },
            "provenance": { "$ref": "#/$defs/provenance" }
          }
        },
        {
          "type": "object",
          "required": ["type", "provider", "title", "src", "sourceUrl", "purpose", "fallbackUrl"],
          "additionalProperties": false,
          "properties": {
            "type": { "const": "external-embed" },
            "provider": {
              "type": "string",
              "enum": ["youtube"],
              "description": "allowlisted embed provider — extend only when a real lesson needs it"
            },
            "title": { "type": "string", "minLength": 1 },
            "src": {
              "type": "string",
              "pattern": "^https://",
              "description": "https embed URL on the original host — never a copied/rehosted asset"
            },
            "sourceUrl": {
              "type": "string",
              "pattern": "^https://",
              "description": "original canonical URL (watch page / chapter page)"
            },
            "purpose": {
              "type": "string",
              "minLength": 1,
              "description": "why this external item contributes to the lesson"
            },
            "fallbackUrl": {
              "type": "string",
              "pattern": "^https://",
              "description": "where the learner goes if the embed cannot load"
            },
            "provenance": { "$ref": "#/$defs/provenance" }
          }
        }
      ]
    }
  }
}
